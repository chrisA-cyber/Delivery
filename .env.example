# Public application origin (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI — server only
OPENAI_API_KEY=
OPENAI_AUDIO_JUDGE_MODEL=gpt-audio-1.5
OPENAI_MODERATION_MODEL=omni-moderation-latest
DELIVERY_AI_MODE=live
# Keep false in production so provider failures are visible instead of scored locally.
DELIVERY_AI_ALLOW_MOCK_FALLBACK=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_ENABLE_AUTOMATIC_TAX=false

# Server-side abuse controls (required in production; use 32+ random characters)
DELIVERY_DEVICE_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protected moderation storage-cleanup worker (32+ random characters in production)
MODERATION_CLEANUP_SECRET=
