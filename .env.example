# Public application origin (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI — server only
OPENAI_API_KEY=
OPENAI_AUDIO_JUDGE_MODEL=gpt-audio-1.5
OPENAI_MODERATION_MODEL=omni-moderation-latest
DELIVERY_AI_MODE=live
# Keep false in production so provider failures are visible instead of scored locally.
DELIVERY_AI_ALLOW_MOCK_FALLBACK=false

# Optional ElevenLabs Scribe v2 companion transcript — server only.
# Accuracy remains on the versioned direct-audio transcript until calibration.
DELIVERY_TRANSCRIPTION_PROVIDER=audio-judge
ELEVENLABS_API_KEY=
# Enable only if your ElevenLabs Enterprise account supports zero retention.
# False uses provider-default retention; never promise zero retention with it.
ELEVENLABS_ZERO_RETENTION=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Keep false until custom SMTP confirmation, sign-in, and reset emails are verified.
# OAuth buttons follow the live enabled providers in Supabase Auth settings.
DELIVERY_AUTH_EMAIL_READY=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_ENABLE_AUTOMATIC_TAX=false

# Server-side abuse controls (required in production; use 32+ random characters)
DELIVERY_DEVICE_SECRET=
# Use one Redis backend. Railway: reference the private Redis service's REDIS_URL.
# Public/native Redis requires rediss://; redis:// is allowed on Railway private networking or loopback.
REDIS_URL=
# Alternative: existing Upstash HTTP REST configuration (leave blank with REDIS_URL).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protected moderation storage-cleanup worker (32+ random characters in production)
MODERATION_CLEANUP_SECRET=

# Roast Off: LiveKit Cloud Build (free, no card; 5,000 minutes/50GB shared monthly).
# Server only. Do not use a self-hosted SFU in production; revocation depends on Cloud.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional comma-separated verified account UUIDs authorized only to host the public roast stage.
# Existing profiles with moderator/admin roles are also authorized. Never first-visitor assignment.
ROAST_PUBLIC_HOST_IDS=
