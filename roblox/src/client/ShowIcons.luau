--!strict
-- Line icons drawn from thin rotated frames (no uploaded images), plus emoji glyphs for reactions.
-- FeatherPaths is generated by tools/feather.py; the extra shapes below follow the same 24-unit grid.
local paths = require(script.Parent.FeatherPaths)
local ShowIcons = {}

local function circle(cx: number, cy: number, r: number, from: number?, to: number?): { number }
	local a, b = from or 0, to or math.pi * 2
	local steps = math.max(8, math.ceil(math.abs(b - a) * r / 2.2))
	local points = {}
	for i = 0, steps do
		local t = a + (b - a) * i / steps
		table.insert(points, cx + r * math.cos(t))
		table.insert(points, cy + r * math.sin(t))
	end
	return points
end
local function eye(): { number }
	local points = {}
	for i = 0, 12 do
		local t = math.pi * i / 12
		table.insert(points, 12 - 11 * math.cos(t))
		table.insert(points, 12 - 8 * math.sin(t))
	end
	for i = 1, 12 do
		local t = math.pi * i / 12
		table.insert(points, 12 + 11 * math.cos(t))
		table.insert(points, 12 + 8 * math.sin(t))
	end
	return points
end

