-- Emoji render in colour through Roblox's text fallback, so they ignore the tint colour.
ShowIcons.emoji = {
	["emoji-rose"] = "🌹",
	["emoji-tomato"] = "🍅",
	["emoji-laugh"] = "😂",
	["emoji-gasp"] = "😮",
	["emoji-meh"] = "😐",
	["emoji-smile"] = "🙂",
	["emoji-grin"] = "😄",
	["emoji-starstruck"] = "🤩",
	["emoji-star"] = "⭐",
	["emoji-party"] = "🎉",
}

function ShowIcons.has(name: string): boolean
	return paths[name] ~= nil or extra[name] ~= nil or ShowIcons.emoji[name] ~= nil
end

function ShowIcons.mount(
	parent: GuiObject,
	name: string,
	sizePx: number,
	color: Color3,
	position: UDim2?,
	thickness: number?
): GuiObject
	local glyph = ShowIcons.emoji[name]
	if glyph then
		local label = Instance.new("TextLabel")
		label.Name = "Icon_" .. name
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromOffset(sizePx, sizePx)
		label.Position = position or UDim2.fromOffset(0, 0)
		label.Text = glyph
		label.TextScaled = true
		label.Font = Enum.Font.BuilderSans
		label.TextColor3 = Color3.new(1, 1, 1)
		label.ZIndex = parent.ZIndex + 1
		label.Parent = parent
		return label
	end
	local root = Instance.new("Frame")
	root.Name = "Icon_" .. name
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromOffset(sizePx, sizePx)
	root.Position = position or UDim2.fromOffset(0, 0)
	root.ZIndex = parent.ZIndex + 1
	root.Parent = parent
	local weight = (thickness or 2.1) / 24
	for _, stroke in paths[name] or extra[name] or {} do
		for i = 3, #stroke, 2 do
			local x1, y1, x2, y2 = stroke[i - 2], stroke[i - 1], stroke[i], stroke[i + 1]
			local dx, dy = x2 - x1, y2 - y1
			local length = math.sqrt(dx * dx + dy * dy)
			local segment = Instance.new("Frame")
			segment.Name = "Stroke"
			segment.AnchorPoint = Vector2.new(0.5, 0.5)
			segment.BackgroundColor3 = color
			segment.BorderSizePixel = 0
			segment.ZIndex = root.ZIndex
			segment.Position = UDim2.fromScale((x1 + x2) / 48, (y1 + y2) / 48)
			segment.Size = UDim2.fromScale((length + 1.0) / 24, weight)
			segment.Rotation = math.deg(math.atan2(dy, dx))
			segment.Parent = root
		end
	end
	return root
end

function ShowIcons.recolor(root: GuiObject, color: Color3)
	if root:IsA("TextLabel") then
		return
	end
	for _, segment in root:GetChildren() do
		if segment:IsA("Frame") and segment.Name == "Stroke" then
			segment.BackgroundColor3 = color
		end
	end
end
return ShowIcons
