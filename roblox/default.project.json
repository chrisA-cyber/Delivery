{
  "name": "Delivery",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "ShowSet": {
        "$path": "art/ShowSet.model.json"
      }
    },
    "ReplicatedStorage": {
      "Delivery": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Delivery": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Delivery": {
          "$path": "src/client"
        }
      }
    },
    "VoiceChatService": {
      "$className": "VoiceChatService",
      "$properties": {
        "EnableDefaultVoice": false,
        "UseAudioApi": "Enabled"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 20,
        "Brightness": 2.2,
        "Ambient": [
          0.32,
          0.27,
          0.38
        ],
        "OutdoorAmbient": [
          0.26,
          0.23,
          0.35
        ],
        "EnvironmentDiffuseScale": 0.5,
        "EnvironmentSpecularScale": 0.8,
        "GlobalShadows": true
      },
      "SoftLenses": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.24,
          "Size": 20,
          "Threshold": 1.12
        }
      }
    }
  }
}
